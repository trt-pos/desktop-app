<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.lebastudios.theroundtable.ui.IconButton?>
<VBox fx:id="root" spacing="5" prefWidth="400"
      xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.lebastudios.theroundtable.dialogs.FormDialogController">
    <padding>
        <Insets bottom="5" left="5" right="5" top="5" />
    </padding>
    <StackPane fx:id="formContainer" VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_RIGHT" spacing="5">
        <IconButton iconName="delete.png" fx:id="deleteButton" onAction="#deleteButtonAction"/>
        <Button onAction="#cancelButtonAction" prefWidth="150" text="%word.cancel"/>
        <Button defaultButton="true" onAction="#saveButtonAction" prefWidth="150" text="%word.save" />
    </HBox>
</VBox>
