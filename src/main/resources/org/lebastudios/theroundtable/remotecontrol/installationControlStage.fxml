<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.lebastudios.theroundtable.ui.*?>
<VBox xmlns="http://javafx.com/javafx" spacing="5"
      xmlns:fx="http://javafx.com/fxml" alignment="CENTER"
      fx:controller="org.lebastudios.theroundtable.remotecontrol.InstallationControlStageController"
      prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <IconView iconName="control-pane.png" iconSize="100"/>
    <Label fx:id="nameLabel"/>
    <Label fx:id="uuidLabel"/>
    <Region VBox.vgrow="ALWAYS"/>
    <FlowPane alignment="CENTER" hgap="10" vgap="10">
        <VBox spacing="10" alignment="CENTER" styleClass="button">
            <IconButton iconName="shutdown.png" onAction="#closeAppInstallationAction" iconSize="60"/>
            <Label text="%core.remotecontrol.closeapp" />
        </VBox>
        <VBox spacing="10" alignment="CENTER" styleClass="button">
            <IconButton iconName="shutdown.png" onAction="#restartAppInstallationAction" iconSize="60"/>
            <Label text="%core.remotecontrol.syncplugins" />
        </VBox>
        <VBox spacing="10" alignment="CENTER" styleClass="button">
            <IconButton iconName="disable.png" onAction="#disableAppInstallationAction" iconSize="60"/>
            <Label text="%core.remotecontrol.disable" />
        </VBox>
        <VBox spacing="10" alignment="CENTER" styleClass="button">
            <IconButton iconName="reload.png" onAction="#syncPluginsAppInstallationAction" iconSize="60"/>
            <Label text="%core.remotecontrol.syncplugins" />
        </VBox>
        <VBox spacing="10" alignment="CENTER" styleClass="button">
            <IconButton iconName="edit.png" onAction="#editAppInstallationAction" iconSize="60"/>
            <Label text="%core.remotecontrol.edit" />
        </VBox>
    </FlowPane>
</VBox>
