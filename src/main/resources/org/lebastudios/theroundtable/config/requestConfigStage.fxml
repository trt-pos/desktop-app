<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx" fx:id="root"
      xmlns:fx="http://javafx.com/fxml" spacing="5"
      fx:controller="org.lebastudios.theroundtable.config.RequestConfigStageController"
      prefHeight="500.0" prefWidth="600.0">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    
    <ScrollPane VBox.vgrow="ALWAYS" pannable="true" fitToWidth="true" fitToHeight="true" fx:id="paneContainer">
        <padding>
            <Insets top="5" right="5" bottom="5" left="5"/>
        </padding>
    </ScrollPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 13;" />
        
    <HBox alignment="CENTER_RIGHT">
        <Button onAction="#accept" text="%core:word.accept" defaultButton="true" prefWidth="150"/>
    </HBox>
</VBox>
