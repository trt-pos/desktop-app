<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:id="root"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.lebastudios.theroundtable.config.PluginsConfigPaneController"
      spacing="15">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <VBox>
        <Label text="Repositories"/>
        <ButtonBar>
            <buttons>
                <Button text="+" onAction="#addRepo" />
                <Button text="-" onAction="#removeRepo" />
            </buttons>
        </ButtonBar>
        <ListView fx:id="reposList"/>
    </VBox>
</VBox>
