<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.lebastudios.theroundtable.components.IconView?>
<VBox xmlns="http://javafx.com/javafx" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.lebastudios.theroundtable.accounts.PrivilegeScalationStageController"
      prefWidth="350.0" spacing="5">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Region prefHeight="25" />
    <IconView fx:id="iconView" iconSize="100" iconName="core:security.png" />
    <Region prefHeight="25" />
    <ChoiceBox fx:id="accountChoiceBox" maxWidth="Infinity"/>
    <PasswordField fx:id="accountPasswordField" promptText="%core:word.password" />
    
    <HBox alignment="CENTER_RIGHT" spacing="5" >
        <Button onAction="#cancel" prefWidth="100" text="%core:word.cancel" />
        <Button onAction="#accept" prefWidth="100" text="%core:word.accept" defaultButton="true" />
    </HBox>
</VBox>
